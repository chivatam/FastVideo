 flash_attn/cute/block_sparse_utils_fp4.py | 397 ++++++++++++++++++++++
 flash_attn/cute/flash_fwd_sm100_fp4.py    |   2 +-
 flash_attn/cute/interface.py              |  32 +-
 3 files changed, 427 insertions(+), 4 deletions(-)
